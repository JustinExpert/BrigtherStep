# Copy this file to .env and fill in the values. Never commit .env.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=brighterstep
# Signs session tokens (JWT). At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Optional: "true" shows password-reset links on screen (demo mailbox, no email server). Leave unset in production.
DEMO_RESET_LINKS=
# Vendor code for the Levels page (which school levels this copy may use). At least 16 characters; keep it
# private — the school never gets it. Without it, levels come from ENABLED_LEVELS and can't be changed in the app.
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
VENDOR_KEY=
# Optional, only used until levels are first saved on the Levels page, e.g. "kinder,elementary". Empty = all.
ENABLED_LEVELS=
