# Copy this file to .env and fill in the values. Never commit .env.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=brighterstep
# Signs session tokens (JWT). At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Optional: "true" shows password-reset links on screen (demo mailbox, no email server). Leave unset in production.
DEMO_RESET_LINKS=
